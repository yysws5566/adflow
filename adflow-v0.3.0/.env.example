# AdFlow 环境变量
# 复制此文件为 .env 并填入实际值（也可启动后在 设置 → API/模型 里填，效果相同）

# ── AI 文案模型（选一个填即可）──

# 阿里百炼 Qwen（推荐，注册送免费额度）https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# DeepSeek https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Moonshot https://platform.moonshot.cn/
MOONSHOT_API_KEY=

# OpenAI 或任意兼容接口（自定义地址在 config.yaml 的 llm.providers.openai）
OPENAI_API_KEY=

# ── 配音 TTS（微软 Edge 免费，无需任何 Key）──

# 火山引擎 https://console.volcengine.com/
VOLCANO_TTS_APP_ID=
VOLCANO_TTS_TOKEN=

# MiniMax https://platform.minimaxi.com/
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# ── 可选 ──
# 自定义 FFmpeg 目录（不在 PATH 中时）
# FFMPEG_PATH=C:\ffmpeg\bin
